# Environment Configuration
# Copy this file to .env and fill in actual values
# DO NOT commit .env with real values to the repository

# Example API key (replace with your actual key)
KEY=YOUR_API_KEY_HERE

# MCP Configuration (optional, for Claude Code / AI tools)
# Figma MCP - Generate at: Figma → Settings → Personal Access Tokens
# FIGMA_ACCESS_TOKEN=your-figma-personal-access-token

# Setup Instructions:
#
# 1. Copy this file: cp .env.example .env
# 2. Replace placeholder values with actual credentials
# 3. Never commit the .env file (it's in .gitignore)
